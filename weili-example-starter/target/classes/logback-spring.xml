<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 从 Apollo 获取配置 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name"/>
    <springProperty scope="context" name="LOKI_URL" source="logging.loki.url"/>
    <springProperty scope="context" name="LOKI_ENABLED" source="logging.loki.enabled" defaultValue="false"/>

    <!-- 1. 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- 使用 SkyWalking 的 Layout -->
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%tid] %-5level %logger{36} - %msg%n</pattern>
            </layout>
        </encoder>
    </appender>

    <!-- 2. Loki 输出（动态启用） -->
    <if condition='"true".equals(property("LOKI_ENABLED"))'>
        <then>
            <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
                <http>
                    <url>${LOKI_URL}</url>
                </http>
                <format>
                    <label>app=${APP_NAME},level=%level</label>
                    <message>
                        <!-- 使用 SkyWalking 的 Trace ID -->
                        {"time":"%d{yyyy-MM-dd HH:mm:ss.SSS}","traceId":"%tid","level":"%level","message":"%msg"}
                    </message>
                </format>
                <batch>
                    <maxItems>${logging.loki.batch-size:-500}</maxItems>
                    <timeout>${logging.loki.timeout:-2000}</timeout>
                </batch>
            </appender>
            <!-- 异步 Loki Appender -->
            <appender name="ASYNC_LOKI" class="ch.qos.logback.classic.AsyncAppender">
                <appender-ref ref="LOKI" />
                <queueSize>1024</queueSize>
            </appender>
        </then>
    </if>

    <!-- 3. 根日志配置 -->
    <root level="${logging.level.root:-INFO}">
        <appender-ref ref="CONSOLE"/>
        <if condition='"true".equals(property("LOKI_ENABLED"))'>
            <then>
                <appender-ref ref="ASYNC_LOKI"/>
            </then>
        </if>
    </root>


    <!-- 4. 启动参数示例
      java -javaagent:/path/to/skywalking-agent/skywalking-agent.jar \
     -Dskywalking.agent.service_name=${APP_NAME} \
     -Dskywalking.collector.backend_service=oap-server:11800 \
     -jar your-app.jar
     -->
</configuration>