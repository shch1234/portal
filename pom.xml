<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.weili.boot</groupId>
        <artifactId>weili-boot-parent</artifactId>
        <version>1.0.0-merge-SNAPSHOT</version>
    </parent>

    <groupId>com.weili.example</groupId>
    <artifactId>weili-framework-example</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>weili-example-starter</module>
        <module>weili-example-domain</module>
        <module>weili-example-dal</module>
        <module>weili-example-common</module>
        <module>weili-example-service</module>
        <module>weili-example-web</module>
        <module>weili-example-task</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <weili-basic.version>1.0.0-merge-SNAPSHOT</weili-basic.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--内部模块依赖-->
            <dependency>
                <groupId>com.weili.example</groupId>
                <artifactId>weili-example-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.example</groupId>
                <artifactId>weili-example-dal</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.example</groupId>
                <artifactId>weili-example-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.example</groupId>
                <artifactId>weili-example-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.example</groupId>
                <artifactId>weili-example-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.example</groupId>
                <artifactId>weili-example-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.example</groupId>
                <artifactId>weili-example-task</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!--依赖模块:按需引入-->
            <dependency>
                <groupId>com.weili.basic</groupId>
                <artifactId>weili-basic-common</artifactId>
                <version>${weili-basic.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.basic</groupId>
                <artifactId>weili-basic-framework</artifactId>
                <version>${weili-basic.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.basic</groupId>
                <artifactId>weili-basic-redis</artifactId>
                <version>${weili-basic.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.basic</groupId>
                <artifactId>weili-basic-xxljob</artifactId>
                <version>${weili-basic.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.basic</groupId>
                <artifactId>weili-basic-apollo</artifactId>
                <version>${weili-basic.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.system</groupId>
                <artifactId>weili-service-system-permission</artifactId>
                <version>${weili.system.version}</version>
            </dependency>
            <dependency>
                <groupId>com.weili.system</groupId>
                <artifactId>weili-service-system-security</artifactId>
                <version>${weili.system.version}</version>
            </dependency>
            <!--三方模块-->
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-archetype-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <propertyFile>archetype.properties</propertyFile>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>nexus-release</id>
            <name>nexus-release</name>
            <url>http://100.100.5.2:9999/repository/maven-releases</url>
        </repository>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>nexus-snapshots</name>
            <url>http://100.100.5.2:9999/repository/maven-snapshots</url>
        </snapshotRepository>
    </distributionManagement>
</project>