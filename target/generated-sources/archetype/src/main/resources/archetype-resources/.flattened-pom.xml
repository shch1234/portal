#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\' )
<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.weili.boot</groupId>
    <artifactId>weili-boot-parent</artifactId>
    <version>${version}</version>
  </parent>
  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}</artifactId>
  <version>${version}</version>
  <packaging>pom</packaging>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <modules>
    <module>weili-example-starter</module>
    <module>weili-example-dal</module>
    <module>weili-example-web</module>
    <module>weili-example-common</module>
    <module>weili-example-service</module>
    <module>weili-example-proxy</module>
  </modules>
  <properties>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.source>17</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${package}</groupId>
        <artifactId>weili-example-starter</artifactId>
        <version>${symbol_dollar}{project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.example.dal</groupId>
        <artifactId>weili-example-dal</artifactId>
        <version>${symbol_dollar}{project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.example.web</groupId>
        <artifactId>weili-example-web</artifactId>
        <version>${symbol_dollar}{project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.example.common</groupId>
        <artifactId>weili-example-common</artifactId>
        <version>${symbol_dollar}{project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.example.proxy</groupId>
        <artifactId>weili-example-proxy</artifactId>
        <version>${symbol_dollar}{project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.basic.common</groupId>
        <artifactId>weili-basic-common</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.basic.framework</groupId>
        <artifactId>weili-basic-framework</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.basic.apollo</groupId>
        <artifactId>weili-basic-apollo</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.basic.redis</groupId>
        <artifactId>weili-basic-redis</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.basic.elaticsearch</groupId>
        <artifactId>weili-basic-elasticsearch</artifactId>
        <version>${version}</version>
      </dependency>
      <dependency>
        <groupId>com.weili.basic.xxljob</groupId>
        <artifactId>weili-basic-xxljob</artifactId>
        <version>${version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>${package}.FrameworkExampleApplication</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>${symbol_dollar}{maven.compiler.source}</source>
          <target>${symbol_dollar}{maven.compiler.target}</target>
          <annotationProcessorPaths>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${symbol_dollar}{org.mapstruct.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>${symbol_dollar}{lombok-mapstruct-binding.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${symbol_dollar}{lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
